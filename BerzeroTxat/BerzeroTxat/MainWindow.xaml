<Window x:Class="BerzeroTxat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BerzeroTxat"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Goiko botoiak -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
            <Button x:Name="btnConectar"
                    Content="Conectar al servidor"
                    Width="175"
                    Height="52"
                    Margin="0,0,35,0"
                    FontSize="13"
                    IsEnabled="False"
                    Background="#FFF8F8F8"
                    BorderBrush="#FFE5E5E5" Click="btnConectar_Click" />

            <Button x:Name="btnDesconectar"
                    Content="Desconectar Cliente"
                    Width="175"
                    Height="52"
                    FontSize="13"
                    Background="#FFF8F8F8"
                    BorderBrush="#FFD0D0D0" Click="btnDesconectar_Click" />
        </StackPanel>

        <!-- IP eta Izena eremuak -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="25,0,0,25">
            <Label x:Name="lblIp"
                   Content="IP Servidor"
                   FontSize="13"
                   Foreground="#FF8E8E8E"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
            <TextBox x:Name="txtIp"
                     Text="127.0.0.1"
                     Width="95"
                     Height="24"
                     FontSize="13"
                     IsEnabled="False"
                     VerticalContentAlignment="Center"
                     Padding="4,0"
                     Margin="0,0,35,0"
                     Background="#FFF0F0F0"
                     BorderBrush="#FFE0E0E0" />

            <Label x:Name="lblNombre"
                   Content="Nombre"
                   FontSize="13"
                   Foreground="#FF8E8E8E"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
            <TextBox x:Name="txtNombre"
                     Text="Itziar"
                     Width="135"
                     Height="24"
                     FontSize="13"
                     IsEnabled="False"
                     VerticalContentAlignment="Center"
                     Padding="4,0"
                     Background="#FFF0F0F0"
                     BorderBrush="#FFABADB3" />
        </StackPanel>

        <!-- Chat GroupBox eremua -->
        <GroupBox Grid.Row="2"
                  Header="Chat"
                  Width="470"
                  HorizontalAlignment="Left"
                  Margin="25,0,0,0"
                  Padding="8,10,8,10"
                  FontSize="13"
                  BorderBrush="#FFD5DFE5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Mezua idazteko koadroa -->
                <TextBox x:Name="txtMensaje"
                         Grid.Row="0"
                         Height="26"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Padding="4,0"
                         Margin="0,4,0,16"
                         Background="White"
                         BorderBrush="#FFABADB3" />

                <!-- Jasotako mezuen historia -->
                <TextBox x:Name="txtHistorial"
                         Grid.Row="1"
                         FontSize="13"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Visible"
                         TextWrapping="Wrap"
                         Padding="4,10,4,4"
                         Margin="0,0,0,14"
                         Background="#FFF0F0F0"
                         BorderBrush="#FFABADB3" />

                <!-- Bidaltzeko botoia -->
                <Button x:Name="btnEnviar"
                        Grid.Row="2"
                        Content="Enviar"
                        Width="255"
                        Height="52"
                        HorizontalAlignment="Center"
                        FontSize="13"
                        Background="#FFF8F8F8"
                        BorderBrush="#FFD0D0D0" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>
